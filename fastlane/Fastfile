default_platform(:ios)

platform :ios do

  desc "Build and upload to App Store Connect"
  lane :release do
    app_slug    = ENV["APP_SLUG"]
    bundle_id   = ENV["BUNDLE_ID"]
    key_id      = ENV["ASC_KEY_ID"]
    issuer_id   = ENV["ASC_ISSUER_ID"]
    private_key = ENV["ASC_PRIVATE_KEY"]
    team_id     = ENV["TEAM_ID"]

    UI.message("Building: #{app_slug} (#{bundle_id})")

    # Write .p8 key to temp file for xcodebuild and altool
    require 'tempfile'
    require 'fileutils'
    key_file = Tempfile.new(['asc_key', '.p8'])
    key_file.write(private_key)
    key_file.flush

    # Also write to ~/.appstoreconnect/private_keys/ for altool auto-discovery
    key_dir  = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(key_dir)
    File.write("#{key_dir}/AuthKey_#{key_id}.p8", private_key)

    api_key = app_store_connect_api_key(
      key_id:                key_id,
      issuer_id:             issuer_id,
      key_content:           private_key,
      is_key_content_base64: false
    )

    update_code_signing_settings(
      path:                  "ios/App/App.xcodeproj",
      use_automatic_signing: true,
      team_id:               team_id,
      bundle_identifier:     bundle_id
    )

    # Version: 2.0.{run_number} — always above any previously-closed 1.x version.
    # Pass via xcargs so it overrides .pbxproj regardless of project settings.
    run_number  = (ENV["GITHUB_RUN_NUMBER"] || "1").to_i
    epoch_min   = (Time.now.to_i / 60) % 1000000
    new_version = "2.0.#{run_number}"
    new_build   = "#{epoch_min}"
    UI.message("Setting version=#{new_version} build=#{new_build}")

    gym(
      scheme:                "App",
      workspace:             "ios/App/App.xcworkspace",
      configuration:         "Release",
      export_method:         "app-store",
      export_options: {
        method:               "app-store",
        teamID:               team_id,
        signingStyle:         "automatic",
        uploadBitcode:        false,
        uploadSymbols:        true,
        compileBitcode:       false
      },
      xcargs:                "-allowProvisioningUpdates MARKETING_VERSION=#{new_version} CURRENT_PROJECT_VERSION=#{new_build} -authenticationKeyPath #{key_file.path} -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}",
      output_directory:      "./build",
      output_name:           "#{app_slug}.ipa",
      clean:                 true,
      silent:                false,
      suppress_xcode_output: false
    )

    key_file.close
    key_file.unlink

    # Upload via pilot — retry up to 3x for transient Apple 500 errors
    upload_attempts = 0
    begin
      upload_attempts += 1
      upload_to_testflight(
        api_key:                           api_key,
        app_identifier:                    bundle_id,
        ipa:                               "./build/#{app_slug}.ipa",
        skip_waiting_for_build_processing: true,
        skip_submission:                   true
      )
    rescue => e
      if upload_attempts < 3 && e.message.to_s.include?("500")
        UI.message("Apple 500 error on attempt #{upload_attempts}, retrying in 30s...")
        sleep(30)
        retry
      end
      raise
    end

    UI.success("✅ Uploaded #{app_slug} to ASC!")
  end

  desc "Upload an already-built .ipa (downloaded from a URL) to TestFlight — no Xcode build step"
  lane :upload_prebuilt do
    ipa_url     = ENV["IPA_URL"]
    bundle_id   = ENV["BUNDLE_ID"]
    key_id      = ENV["ASC_KEY_ID"]
    issuer_id   = ENV["ASC_ISSUER_ID"]
    private_key = ENV["ASC_PRIVATE_KEY"]

    UI.message("Downloading prebuilt ipa for #{bundle_id} from #{ipa_url}")
    sh("curl -fL '#{ipa_url}' -o app.ipa")

    api_key = app_store_connect_api_key(
      key_id:                key_id,
      issuer_id:             issuer_id,
      key_content:           private_key,
      is_key_content_base64: false
    )

    upload_attempts = 0
    begin
      upload_attempts += 1
      upload_to_testflight(
        api_key:                           api_key,
        app_identifier:                    bundle_id,
        ipa:                               "./app.ipa",
        skip_waiting_for_build_processing: true,
        skip_submission:                   true
      )
    rescue => e
      if upload_attempts < 3 && e.message.to_s.include?("500")
        UI.message("Apple 500 error on attempt #{upload_attempts}, retrying in 30s...")
        sleep(30)
        retry
      end
      raise
    end

    UI.success("✅ Uploaded prebuilt ipa (#{bundle_id}) to ASC!")
  end

end
