default_platform(:ios)

platform :ios do

  desc "Build and upload to App Store Connect"
  lane :release do
    app_slug    = ENV["APP_SLUG"]
    bundle_id   = ENV["BUNDLE_ID"]
    key_id      = ENV["ASC_KEY_ID"]
    issuer_id   = ENV["ASC_ISSUER_ID"]
    private_key = ENV["ASC_PRIVATE_KEY"]
    team_id     = ENV["TEAM_ID"]

    UI.message("Building: #{app_slug} (#{bundle_id})")

    # Write .p8 key where altool and xcodebuild both expect it
    require 'fileutils'
    key_dir  = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(key_dir)
    key_path = "#{key_dir}/AuthKey_#{key_id}.p8"
    File.write(key_path, private_key)

    # Set up API key context (used by signing/provisioning steps)
    app_store_connect_api_key(
      key_id:                key_id,
      issuer_id:             issuer_id,
      key_content:           private_key,
      is_key_content_base64: false
    )

    # Update code signing to automatic with the team
    update_code_signing_settings(
      path:                  "ios/App/App.xcodeproj",
      use_automatic_signing: true,
      team_id:               team_id,
      bundle_identifier:     bundle_id
    )

    # Build — force Distribution signing to skip Dev cert check on ephemeral runners
    gym(
      scheme:                "App",
      workspace:             "ios/App/App.xcworkspace",
      configuration:         "Release",
      export_method:         "app-store",
      export_options: {
        method:               "app-store",
        teamID:               team_id,
        signingStyle:         "automatic",
        uploadBitcode:        false,
        uploadSymbols:        true,
        compileBitcode:       false
      },
      xcargs:                "CODE_SIGN_IDENTITY='Apple Distribution' -allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}",
      output_directory:      "./build",
      output_name:           "#{app_slug}.ipa",
      clean:                 true,
      silent:                false,
      suppress_xcode_output: false
    )

    # Upload via xcrun altool (bypasses Spaceship::Tunes auth issues in deliver)
    sh("xcrun altool --upload-app --type ios --file '../build/#{app_slug}.ipa' --apiKey '#{key_id}' --apiIssuer '#{issuer_id}' 2>&1")

    File.delete(key_path) if File.exist?(key_path)

    UI.success("✅ Uploaded #{app_slug} to ASC!")
  end

end
